#!/bin/bash

### Script for executing jobs on Cluster Cemef
### [March 2025]

### Set core count and maximum job duration hh:mm:ss
#OAR -l core=24,walltime=00:50:00
### Set job name
#OAR -n job_exemple
#OAR -O %jobid%.out
#OAR -E %jobid%.out

### Run with: oarsub -S ./job_exemple.sh
### Or with: oarsub -l core=32 -S ./job_exemple.sh

### Set your executable path
MONPROG=/gext/shubhankar.shubhanka/Shubh/ParallelProgrammingCourse/TPs/ParallelProgrammingTP/bin/sparseemv_mpi2.exe
### Set your data file (if needed)
MYDATA=

### Standard execution parameters below this line

echo "STARTING EXECUTION"
date

# Determine available cores
NP=$(cat $OAR_NODE_FILE | wc -l)
echo "Running on $NP cores"
echo "Node allocation: $(cat $OAR_NODE_FILE)"

# Define MPI launcher with path to OpenMPI
MPIRUN="/softs/mpi/openmpi-1.10.7/gcc-7.3.0/bin/mpirun"

# Enable command echoing and set thread count
set -x
export OMP_NUM_THREADS=1

# Main execution loop with error checking
if [ -f $MONPROG ]; then
  if [ -z "$MYDATA" ] || [ -f $MYDATA ]; then
    # Test with various processor counts
    for np in 1 2 4 8 12 16 24
    do
      # Test with different problem sizes
      for nx in 50 100 150 200
      do
        echo "Running with nx=$nx on $np cores..."
        $MPIRUN -np ${np} $MONPROG --nx $nx > log-NX${nx}-NPI${np}
      done
    done
  else
    echo "ERROR: Data file $MYDATA not found!"
  fi
else
  echo "ERROR: Program $MONPROG not found!"
fi

# Disable command tracing
set +x

date
echo "EXECUTION COMPLETE"
